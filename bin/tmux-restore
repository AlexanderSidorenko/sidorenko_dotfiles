#!/usr/bin/env bash
# tmux-restore — run the restore script that tmux-snapshot last generated.
#
# WHY
#
# The snapshot lands under XDG_STATE_HOME, which is not a path anybody wants to
# type after a reboot. This is the front door: it finds the file, tells you how
# old it is before running it, and forwards its flags.
#
# Recovery: --prev runs the previous generation instead. tmux-snapshot keeps one,
# which matters because the snapshot rewrites itself on every layout change — if
# a bad capture lands, the good one is still there for exactly one write.
#
# --contents is the other half of a reboot: the scrollback tmux-snapshot dumped
# alongside the layout. It lists the dumps rather than replaying them into the
# restored panes, which would only manufacture a pane whose history is a lie.
# For output that was still arriving when the machine went down, see
# tmux-pipe-log --list.
#
# Usage:
#   tmux-restore [--prev] [--no-attach] [--dry-run] [--path] [--contents] [--help]
#
#   --prev         run the previous snapshot rather than the current one
#   --path         print the snapshot path and exit
#   --contents     list the captured pane scrollback instead of restoring
#   --no-attach    create the sessions but do not attach
#   --dry-run      print what would happen, change nothing
#
# Env fallbacks: TMUX_SNAPSHOT_OUT, XDG_STATE_HOME

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-snapshot"
SNAP="${TMUX_SNAPSHOT_OUT:-$STATE_DIR/restore-tmux-sessions.sh}"
CONTENTS_DIR="$STATE_DIR/contents"
LIST_CONTENTS=""
PASS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --prev)
    SNAP="$SNAP.prev"
    CONTENTS_DIR="$CONTENTS_DIR.prev"
    shift
    ;;
  --contents)
    LIST_CONTENTS=1
    shift
    ;;
  --path)
    printf '%s\n' "$SNAP"
    exit 0
    ;;
  -h | --help)
    sed -n '/^# Usage:/,/^# Env fallbacks/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    PASS+=("$1")
    shift
    ;;
  esac
done

if [[ -n "$LIST_CONTENTS" ]]; then
  if [[ ! -d "$CONTENTS_DIR" ]]; then
    printf '\033[0;31mtmux-restore: no scrollback at %s\033[0m\n' "$CONTENTS_DIR" >&2
    printf 'Capture some while your sessions are up:  tmux-snapshot --contents\n' >&2
    exit 1
  fi
  printf '\033[2m%s\033[0m\n\n' "$CONTENTS_DIR"
  printf '%-24s %8s  %s\n' "PANE" "LINES" "COMMAND / FILE"
  for f in "$CONTENTS_DIR"/*.txt; do
    [[ -e "$f" ]] || continue
    pane=$(sed -n 's/^# pane:  *//p' "$f" | head -1)
    lines=$(sed -n 's/^# captured: .*(\([0-9]*\) lines)$/\1/p' "$f" | head -1)
    cmd=$(sed -n 's/^# command:  *//p' "$f" | head -1)
    printf '%-24s %8s  %s\n' "$pane" "${lines:-?}" "$cmd"
    printf '\033[2m%-24s %8s  %s\033[0m\n' "" "" "$f"
  done
  printf '\n\033[2mread one with:  less %s/<file>\033[0m\n' "$CONTENTS_DIR"
  printf '\033[2mstill-streaming output from that run:  tmux-pipe-log --list --prev\033[0m\n'
  exit 0
fi

if [[ ! -f "$SNAP" ]]; then
  printf '\033[0;31mtmux-restore: no snapshot at %s\033[0m\n' "$SNAP" >&2
  printf 'Take one while your sessions are up:  tmux-snapshot --force\n' >&2
  exit 1
fi

age=$(( $(date +%s) - $(stat -c %Y "$SNAP") ))
printf '\033[2mrestoring %s (captured %dh %dm ago)\033[0m\n' \
  "$SNAP" "$((age / 3600))" "$(((age % 3600) / 60))"

exec bash "$SNAP" ${PASS[@]+"${PASS[@]}"}
