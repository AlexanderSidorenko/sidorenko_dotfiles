#!/usr/bin/env bash
#
# post-commit — warn when a commit leaves `job` no longer folded onto `master`.
#
# AGENTS.md keeps `master` as the public baseline and `job` as work-specific
# commits rebased on top of it. The step that actually gets skipped is the one
# right after a generic commit lands on `master`: nothing is dirty, nothing
# failed, and the change feels finished — `master` has simply moved and `job` is
# quietly no longer folded onto it. There is no other signal at that moment, so
# this makes one.
#
# Advisory only. post-commit cannot fail a commit and must never try to; it says
# what to run and gets out of the way.
#
# Two things it deliberately cannot do:
#   - Catch a commit authored with git plumbing (commit-tree / update-ref). No
#     hook runs for those at all, which is why AGENTS.md forbids them outright
#     rather than relying on this.
#   - Fire during a rebase. git does not run post-commit for replayed commits,
#     which is correct here: the rebase IS the fold.
#
# Installed by install.sh as <repo>/.git/hooks/post-commit (a symlink, so edits
# here take effect immediately).
#
# This file must live on `master`, not on `job`. .git/hooks/post-commit is a
# symlink into the worktree, so the hook exists only while a branch that carries
# the file is checked out. Kept on `job` alone it dangles whenever `master` is
# checked out — and git skips a missing hook silently — which is precisely the
# case it exists to catch. It was on `job` for exactly one commit and never fired
# once. The no-op below when there is no `job` branch is what makes it harmless
# on personal machines, so `master` costs nothing.
set -euo pipefail

# Both branches must exist. Personal checkouts have no `job`, so this no-ops.
git rev-parse --verify --quiet refs/heads/job >/dev/null || exit 0
git rev-parse --verify --quiet refs/heads/master >/dev/null || exit 0

# `git branch --show-current` gives the bare name; unlike `rev-parse
# --abbrev-ref HEAD` it does not prepend `heads/` when a remote shares the
# branch's name — which the `job` remote here does.
branch="$(git branch --show-current 2>/dev/null || true)"
case "$branch" in
master | job) ;;
*) exit 0 ;;
esac

# Folded already: `job` contains every commit on `master`.
if git merge-base --is-ancestor refs/heads/master refs/heads/job 2>/dev/null; then
  exit 0
fi

behind="$(git rev-list --count refs/heads/job..refs/heads/master 2>/dev/null || echo '?')"

YELLOW="$(printf '\033[0;33m')"
BOLD="$(printf '\033[1m')"
RESET="$(printf '\033[0m')"

{
  printf '%b!! job is no longer folded onto master (%s commit(s) behind).%b\n' \
    "$YELLOW$BOLD" "$behind" "$RESET"
  if [[ "$branch" == master ]]; then
    printf '   master just moved. AGENTS.md: rebase job onto the new master before moving on.\n'
  fi
  printf '   claude/skills/job-branch-sync/bin/sync-dance   # or: git switch job && git rebase master\n'
  printf '   Nothing is pushed without your explicit confirmation.\n'
} >&2

exit 0
