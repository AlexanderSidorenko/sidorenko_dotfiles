# Create a compressed tarball with a pv progress bar.
# The format is chosen automatically from the output filename extension:
#   .tar.gz / .tgz   — gzip   (fast, ubiquitous)
#   .tar.bz2 / .tbz2 — bzip2  (better ratio, slower)
#   .tar.xz / .txz   — xz     (best ratio, slowest)
#   .tar.zst / .tzst — zstd   (near-xz ratio, much faster)
#   .tar.lz4         — lz4    (fastest, least compression)
# Usage: tarpv <output.tar.gz> <file|dir>...
tarpv() {
  if [[ $# -lt 2 ]]; then
    echo "usage: tarpv <output.tar.gz> <file|dir>..." >&2
    return 1
  fi
  local out="$1"; shift
  local total
  total="$(du --bytes --summarize --total -- "$@" | awk 'END { print $1 }')"
  echo "Total: ${total} bytes"
  tar caf - -- "$@" | pv --progress --eta --rate --bytes --size "$total" > "$out"
}

# Extract a tarball with a pv progress bar.
# Supports all formats listed above; compression is auto-detected from the stream.
# Usage: untarpv <tarball> [dest]
untarpv() {
  if [[ $# -lt 1 ]]; then
    echo "usage: untarpv <tarball> [dest]" >&2
    return 1
  fi
  local src="$1"
  local dest="${2:-}"
  if [[ -n "$dest" ]]; then
    pv "$src" | tar xaf - -C "$dest"
  else
    pv "$src" | tar xaf -
  fi
}

# Look up a cheat sheet from cht.sh.
# Usage: cheat <topic>  (e.g. cheat tar, cheat python/list-comprehension)
cheat() {
  [[ -n "${1:-}" ]] || { echo "usage: cheat <topic>" >&2; return 1; }
  curl -fsSL "cht.sh/$1"
}

timer() {
  local start end
  start="$(date +%s)"
  "$@"
  local ec=$?
  end="$(date +%s)"
  echo "Elapsed: $((end-start))s (exit $ec)"
  return $ec
}

cgr() {
  command -v git >/dev/null 2>&1 || return 1
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Not in a git repo" >&2; return 2; }
  cd "$root" || return
}

rgf() {
  rg --hidden --follow --smart-case --glob '!.git/' "$@"
}

whop() {
  local port="$1"
  [[ -n "$port" ]] || { echo "usage: whop <port>" >&2; return 2; }
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN
  elif command -v ss >/dev/null 2>&1; then
    ss -ltnp "sport = :$port"
  else
    echo "Install lsof or ss" >&2
    return 1
  fi
}

fzf-kill() {
  local selected
  selected="$(ps aux | fzf -i -m --header-lines=1 --header="Select process(es) to kill (Tab to multi-select)")"
  [[ -n "$selected" ]] || return 0
  local pids
  pids="$(echo "$selected" | awk '{print $2}')"
  echo "$selected" | awk '{print "Killing: " $11, "(" $2 ")"}'
  echo "$pids" | xargs kill
}

# Full reinstall of Nix packages: diff installed vs desired, then install all.
nix_reinstall() {
  local dotdir="${SIDORENKO_DOTFILES:-$HOME/.sidorenko_dotfiles}"
  local pkg_file="${dotdir}/nix-packages.sh"

  if [[ ! -r "$pkg_file" ]]; then
    echo "nix_reinstall: package list not found: $pkg_file" >&2
    return 1
  fi
  if ! command -v nix-env >/dev/null 2>&1; then
    echo "nix_reinstall: nix-env not found" >&2
    return 1
  fi

  # shellcheck source=nix-packages.sh
  local NIX_PACKAGES=()
  source "$pkg_file"

  local installed desired
  installed="$(nix-env -q | sort)"
  desired="$(printf '%s\n' "${NIX_PACKAGES[@]}" | sort)"

  echo "=== Diff (< installed, > desired) ==="
  diff <(echo "$installed") <(echo "$desired") || true
  echo ""

  local nix_args=()
  local pkg
  for pkg in "${NIX_PACKAGES[@]}"; do
    nix_args+=("nixpkgs.$pkg")
  done

  echo "Installing ${#NIX_PACKAGES[@]} packages..."
  nix-env -iA "${nix_args[@]}"
  echo "Done."
}

