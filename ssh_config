# sidorenko_dotfiles ssh defaults.
# Included from ~/.ssh/config via `Include ~/.sidorenko_dotfiles/ssh_config`.
# Per-host overrides in ~/.ssh/config still take precedence — first match wins,
# so any `Host <name>` block ABOVE the Include line in ~/.ssh/config wins over
# these defaults.

Host *
    # Keep idle connections alive (NAT/firewall friendly)
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Connection multiplexing: reuse a single TCP connection for subsequent
    # ssh/scp/rsync to the same host. Massive speedup for repeated commands.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

    # Auto-add keys to the running ssh-agent on first use
    AddKeysToAgent yes

    # Hash hostnames in known_hosts (privacy: leaked file doesn't reveal hosts)
    HashKnownHosts yes

    # Compression helps on slow/lossy links, hurts on fast ones — leave off by
    # default; enable per-host as needed.
    # Compression yes
